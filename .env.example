# MongoDB connection string. Local dev example:
#   MONGODB_URI=mongodb://127.0.0.1:27017/MinhasPA
# Atlas example:
#   MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/MinhasPA?retryWrites=true&w=majority
# No manual setup needed on the Mongo side — the database and every
# collection are created automatically the first time the app writes to them.
MONGODB_URI=mongodb://127.0.0.1:27017/MinhasPA

JWT_SECRET=
JWT_EXPIRES_IN=

# Used to encrypt bill portal credentials (Bills > Credentials section) with
# AES-256-GCM — any long random string works, it's hashed into a 32-byte key.
ENCRYPTION_KEY=

# Market data providers (all optional — leave blank and that asset type
# just won't have live prices; nothing else breaks)
TWELVE_DATA_API_KEY=
COINGECKO_API_KEY=
GOLD_API_KEY=

# Cache TTLs in minutes (how long a fetched price is reused before the next
# refresh hits the provider again). Optional — sane defaults are built in.
STOCK_CACHE_TTL_MINUTES=5
CRYPTO_CACHE_TTL_MINUTES=1
GOLD_CACHE_TTL_MINUTES=1
FX_CACHE_TTL_MINUTES=10

# ===== Only needed to RUN THE ONE-TIME MIGRATION (scripts/migrate-mssql-to-mongo.js) =====
# Your OLD SQL Server connection details, so the migration script can read
# your existing data and copy it into MongoDB. Not used by the app itself —
# safe to delete these two lines once the migration has run successfully.
OLD_DB_SERVER=
OLD_DB_DATABASE=
